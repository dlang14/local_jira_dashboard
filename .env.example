# Copy this file to .env and fill in the values. Never commit .env.

# Required: your Jira Cloud site (no trailing slash)
JIRA_BASE_URL=https://your-site.atlassian.net

# Required: the Atlassian account email the API token belongs to
JIRA_EMAIL=you@example.com

# Required: API token from https://id.atlassian.com/manage-profile/tokens
JIRA_API_TOKEN=

# Optional: listen port (default 8787)
# PORT=8787

# Set to 1 to force mock/demo mode even if a token is present
# MOCK=0

# Optional macOS Keychain fallback if JIRA_API_TOKEN is empty.
# Create the item with:
#   security add-generic-password -s jira-api-token -a you@example.com -w
# JIRA_KEYCHAIN_SERVICE=jira-api-token
